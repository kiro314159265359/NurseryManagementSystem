{
  "info": {
    "name": "Nursery Management System - Live Unified API",
    "description": "Live MonsterASP API for the admin and parent Flutter applications. Login automatically stores accessToken, refreshToken, currentUserId, currentUserName, and currentRole as collection variables. Invoice money fields are baseFee, overtimeAmount, and totalDue. No credentials are included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://nursery-management-api.runasp.net",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginUserName",
      "value": "",
      "type": "string"
    },
    {
      "key": "loginPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "parentEmail",
      "value": "parent@example.com",
      "type": "string"
    },
    {
      "key": "parentPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentUserName",
      "value": "",
      "type": "string"
    },
    {
      "key": "currentRole",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "childId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "assignmentId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "invoiceId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "scheduleId",
      "value": "00000000-0000-0000-0000-000000000000",
      "type": "string"
    },
    {
      "key": "scanCode",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('healthy'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Parent Registration and Approval",
      "item": [
        {
          "name": "Self-register Parent + First Child (Pending)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration\": {\n    \"accountOwner\": \"Mother\",\n    \"password\": \"{{parentPassword}}\",\n    \"child\": {\n      \"fullName\": \"Test Child\",\n      \"dateOfBirth\": \"2021-05-10\",\n      \"enrollmentDate\": \"2026-08-30\",\n      \"nationality\": \"Egyptian\",\n      \"religion\": \"Christian\",\n      \"homeAddress\": \"Test address\",\n      \"allergies\": null,\n      \"requestedPlanId\": null,\n      \"mother\": { \"phone\": \"+201001234567\", \"email\": \"{{parentEmail}}\", \"occupation\": \"Engineer\", \"jobTitle\": \"Engineer\", \"companyName\": \"Example\", \"workPhone\": \"+20212345678\", \"address\": \"Work address\", \"fullName\": \"Test Mother\" },\n      \"father\": { \"phone\": \"+201009876543\", \"email\": \"father@example.com\", \"occupation\": \"Accountant\", \"jobTitle\": \"Accountant\", \"companyName\": \"Example\", \"workPhone\": \"+20287654321\", \"address\": \"Work address\", \"fullName\": \"Test Father\" },\n      \"agreement\": { \"mediaPermission\": true, \"parentSignature\": \"Test Mother\", \"signedDate\": \"2026-08-30\", \"acceptedTerms\": true },\n      \"emergencyContacts\": [{ \"name\": \"Test Grandparent\", \"relationship\": \"Grandparent\", \"phone\": \"+201112345678\" }]\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/api/registrations/self",
            "description": "Public. Change accountOwner to Father to use the father's email as the login username. Account and child remain pending."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { const body = pm.response.json(); pm.collectionVariables.set('childId', body.childId); pm.collectionVariables.set('userId', body.parentUserId); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Create Approved Parent + Child",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registration\": {\n    \"accountOwner\": \"Mother\",\n    \"password\": \"{{parentPassword}}\",\n    \"child\": {\n      \"fullName\": \"Admin Registered Child\", \"dateOfBirth\": \"2021-05-10\", \"enrollmentDate\": \"2026-08-30\", \"nationality\": \"Egyptian\", \"religion\": \"Christian\", \"homeAddress\": \"Test address\", \"allergies\": null, \"requestedPlanId\": null,\n      \"mother\": { \"phone\": \"+201001234567\", \"email\": \"{{parentEmail}}\", \"occupation\": \"Engineer\", \"jobTitle\": \"Engineer\", \"companyName\": \"Example\", \"workPhone\": \"+20212345678\", \"address\": \"Work address\", \"fullName\": \"Test Mother\" },\n      \"father\": { \"phone\": \"+201009876543\", \"email\": \"father@example.com\", \"occupation\": \"Accountant\", \"jobTitle\": \"Accountant\", \"companyName\": \"Example\", \"workPhone\": \"+20287654321\", \"address\": \"Work address\", \"fullName\": \"Test Father\" },\n      \"agreement\": { \"mediaPermission\": true, \"parentSignature\": \"Test Mother\", \"signedDate\": \"2026-08-30\", \"acceptedTerms\": true }, \"emergencyContacts\": []\n    }\n  }\n}"
            },
            "url": "{{baseUrl}}/api/registrations/admin",
            "description": "SuperAdmin or SubAdmin. Creates an immediately approved parent and child."
          }
        },
        {
          "name": "Parent Add Another Child (Pending)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child\": {\n    \"fullName\": \"Second Child\", \"dateOfBirth\": \"2022-03-15\", \"enrollmentDate\": \"2026-09-01\", \"nationality\": \"Egyptian\", \"religion\": \"Christian\", \"homeAddress\": \"Test address\", \"allergies\": null, \"requestedPlanId\": null,\n    \"mother\": { \"phone\": \"+201001234567\", \"email\": \"{{parentEmail}}\", \"occupation\": \"Engineer\", \"jobTitle\": \"Engineer\", \"companyName\": \"Example\", \"workPhone\": \"+20212345678\", \"address\": \"Work address\", \"fullName\": \"Test Mother\" },\n    \"father\": { \"phone\": \"+201009876543\", \"email\": \"father@example.com\", \"occupation\": \"Accountant\", \"jobTitle\": \"Accountant\", \"companyName\": \"Example\", \"workPhone\": \"+20287654321\", \"address\": \"Work address\", \"fullName\": \"Test Father\" },\n    \"agreement\": { \"mediaPermission\": true, \"parentSignature\": \"Test Mother\", \"signedDate\": \"2026-08-30\", \"acceptedTerms\": true }, \"emergencyContacts\": []\n  }\n}"
            },
            "url": "{{baseUrl}}/api/registrations/children"
          }
        },
        {
          "name": "My Child Registration Statuses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/registrations/mine"
          }
        },
        {
          "name": "List Pending Registrations (Admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/registrations/pending"
          }
        },
        {
          "name": "Approve Registration (Admin)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/registrations/{{childId}}/approve"
          }
        },
        {
          "name": "Reject Registration (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Please contact the nursery to correct the submitted information.\"\n}"
            },
            "url": "{{baseUrl}}/api/registrations/{{childId}}/reject"
          }
        }
      ]
    },
    {
      "name": "Authentication and Account",
      "item": [
        {
          "name": "Login (Admin or Parent)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"{{loginUserName}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "For parent accounts, userName is the email used during registration."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "  pm.collectionVariables.set('currentUserId', body.userId);",
                  "  pm.collectionVariables.set('currentUserName', body.userName);",
                  "  pm.collectionVariables.set('currentRole', body.role);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) { const body = pm.response.json(); pm.collectionVariables.set('accessToken', body.accessToken); pm.collectionVariables.set('refreshToken', body.refreshToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke Token (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/revoke"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 204) { pm.collectionVariables.set('accessToken', ''); pm.collectionVariables.set('refreshToken', ''); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/account/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Name\",\n  \"phoneNumber\": \"+201001234567\"\n}"
            },
            "url": "{{baseUrl}}/api/account/me"
          }
        },
        {
          "name": "Change My Password",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{loginPassword}}\",\n  \"newPassword\": \"NewStrongPassword123!\"\n}"
            },
            "url": "{{baseUrl}}/api/account/password",
            "description": "Returns Problem Details code INVALID_CURRENT_PASSWORD or WEAK_PASSWORD for the corresponding field."
          }
        }
      ]
    },
