{
  "info": {
    "_postman_id": "nursery-management-system-api",
    "name": "Nursery Management System API",
    "description": "Complete API collection for Nursery Management System with all endpoints for authentication, user management, children management, attendance tracking, billing, scheduling, and plan assignments.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "Authentication endpoints for login, token refresh, and logout",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "    pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    pm.environment.set(\"userId\", jsonData.userId);",
                  "    console.log('Access Token: ' + jsonData.accessToken);",
                  "    console.log('User ID: ' + jsonData.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@nursery.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticate user and get JWT tokens\n\n**Request Body:**\n- `email` (string): User email address\n- `password` (string): User password\n\n**Response:**\n- `accessToken` (string): JWT access token for authenticated requests\n- `refreshToken` (string): Refresh token for getting new access tokens\n- `userId` (string): ID of the authenticated user\n- `expiresIn` (integer): Token expiration time in seconds"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Refresh an expired access token using the refresh token\n\n**Request Body:**\n- `refreshToken` (string): Valid refresh token from login response\n\n**Response:**\n- `accessToken` (string): New JWT access token\n- `refreshToken` (string): New refresh token\n- `expiresIn` (integer): Token expiration time in seconds"
          },
          "response": []
        },
        {
          "name": "Revoke Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/revoke",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "revoke"]
            },
            "description": "Revoke/logout by invalidating the refresh token\n\n**Request Body:**\n- `refreshToken` (string): Refresh token to revoke\n\n**Response:**\n- `204 No Content` on success"
          },
          "response": []
        }
      ]
    },
